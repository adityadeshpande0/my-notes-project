# Copy to .env.local for local testing, or add these in Vercel:
# Project → Settings → Environment Variables. Never commit a real .env file.

# PostHog project API key (Project settings → "Project API key", starts with phc_).
# It is a public key (it ends up in the browser), but keep it out of git anyway.
# Leave it empty and PostHog stays off.
VITE_POSTHOG_KEY=

# Optional. Defaults to /ingest, which vercel.json forwards to PostHog's US cloud.
# EU project? Change the two rewrites in vercel.json to eu.i.posthog.com /
# eu-assets.i.posthog.com and set VITE_POSTHOG_UI_HOST=https://eu.posthog.com
# VITE_POSTHOG_HOST=/ingest
# VITE_POSTHOG_UI_HOST=https://us.posthog.com
